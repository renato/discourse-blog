<article class="blog-article">
  <header class="blog-article__header">
    <a class="blog__eyebrow" href="{{ @site.url }}">← {{ @labels.all_articles }}</a>
    <h1>{{ @article.title }}</h1>
    {{#if @article.standfirst}}<p class="blog-article__standfirst">{{ @article.standfirst }}</p>{{/if}}
    <div class="blog__meta"><span>{{ @article.author }}</span><span>·</span>
      {{#if @article.published_at}}<time datetime="{{ @article.published_at }}">{{ @article.date }}</time><span>·</span>{{/if}}
      <span>{{ @article.reading_time }}</span>
    </div>
    {{#if @article.updated_label}}<p class="blog__updated">{{ @article.updated_label }}</p>{{/if}}
  </header>
  <div class="blog-article__body cooked">{{ @article.body_html }}</div>
  <footer class="blog-article__footer">
    <div class="blog__tags">{{#each @article.tags as |tag|}}<a href="{{ tag.url }}">{{ tag.name }}</a>{{/each}}</div>
    <a href="{{ @article.discussion_url }}">{{ @labels.view_topic }} ↗</a>
  </footer>
</article>
